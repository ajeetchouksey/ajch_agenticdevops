# Azure Infrastructure Deployment Configuration Template
# Copy this to .env or set as environment variables

# Required Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Infrastructure Configuration
RESOURCE_GROUP_NAME=AI_Agent_RG
LOCATION=eastus
VM_NAME=MyAIInfraVM
VM_SIZE=Standard_DS1_v2
ADMIN_USERNAME=azureuser
VM_ADMIN_PASSWORD=your-secure-password-here

# Optional: AI Decision Configuration
# Set this to enable AI-driven deployment decisions
OPENAI_API_KEY=your-openai-api-key-here

# Deployment Tags (optional)
DEPLOYMENT_PURPOSE=infrastructure_deployment
CREATED_BY=ai_agent